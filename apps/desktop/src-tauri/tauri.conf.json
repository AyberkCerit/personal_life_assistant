{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PLA",
  "version": "0.1.0",
  "identifier": "dev.ayberkcerit.pla",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "PLA", "width": 1280, "height": 720, "minWidth": 1024, "minHeight": 600, "center": true, "visible": false, "dragDropEnabled": false }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "llama/": "llama/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "Ayberk Cerit",
    "copyright": "© 2026 Ayberk Cerit",
    "shortDescription": "Offline personal assistant for your notes",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false,
        "customLanguageFiles": { "Turkish": "installer/Turkish.nsh", "English": "installer/English.nsh" },
        "installerHooks": "installer/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
